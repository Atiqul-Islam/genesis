    "@atiqul/genesis-memory-server-linux-x64-gnu": "0.1.0",
    "@atiqul/genesis-memory-server-linux-x64-musl": "0.1.0",
    "@atiqul/genesis-memory-server-win32-arm64": "0.1.0",
    "@atiqul/genesis-memory-server-win32-x64": "0.1.0"
