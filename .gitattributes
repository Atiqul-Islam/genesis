# Normalize line endings. Force LF on all scripts + extensionless launchers so they run under
# git bash / node / python on Windows, where Git-for-Windows' default core.autocrlf=true would
# otherwise rewrite them to CRLF and break shebangs and heredocs.
* text=auto

*.sh   text eol=lf
*.py   text eol=lf
*.js   text eol=lf
*.cjs  text eol=lf
*.mjs  text eol=lf
*.json text eol=lf
# Force LF on Markdown too: build-plugin-agents reads team/*.md and writes agents/*.md, and the committed
# agents are LF — without this, a Windows checkout (core.autocrlf) makes both CRLF and the no-drift test
# fails on Windows only (the committed LF files "drift" from CRLF-regenerated output). See #25 CI triage.
*.md   text eol=lf

# Extensionless shell/python helpers that carry a shebang. (scripts/fetch-model.mjs is covered
# by the `*.mjs eol=lf` rule above.)
skills/subagent-driven-development/scripts/task-brief     text eol=lf
skills/subagent-driven-development/scripts/review-package text eol=lf
skills/subagent-driven-development/scripts/sdd-workspace  text eol=lf
