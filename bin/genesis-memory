#!/usr/bin/env python3
"""Genesis memory server launcher — download-as-dependency, no Rust required.

The Genesis plugin ships this thin, dependency-free (stdlib only) Python launcher instead of a
prebuilt binary. On first run it resolves the prebuilt `genesis-memory-server` for the current
OS/arch plus the pinned ONNX model from the plugin's GitHub Releases, verifies every download
against a pinned SHA-256, caches them under a persistent USER cache dir (never the read-only,
version-churned plugin dir), then EXEC-replaces itself with the cached binary so the MCP stdio
protocol passes through completely untouched. Subsequent runs skip straight to exec.

Referenced by the plugin `.mcp.json` as:
    { "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/bin/genesis-memory"] }
(or invoked directly — it is `chmod +x` with a `python3` shebang).

======================================================================================
TRUST MODEL (fail-closed; never exec an unverified binary)
--------------------------------------------------------------------------------------
The launcher pins exactly TWO release-time values: PINNED_VERSION (the release tag) and
CHECKSUMS_SHA256 (the SHA-256 of that release's `checksums.txt`). `checksums.txt` is the
single source of truth for every per-asset hash; pinning ONLY its own hash is what avoids
"hardcoded-then-drift": there is exactly one value to update per release, and it anchors the
integrity of every downloaded asset.

  1. Download `checksums.txt` for PINNED_VERSION and verify it against CHECKSUMS_SHA256.
     (Anything that tampered with an asset would have to also change checksums.txt, which
      would change its hash and be rejected here.)
  2. Parse it → { asset_filename: sha256 }.
  3. Download the platform binary + the model archive; verify each against its checksums entry.
  4. Extra tie to the pinned HF revision: verify the extracted onnx/model.onnx against
     MODEL_ONNX_SHA256 (the golden-vector revision — see docs/SPEC_FORGE_RUST_UPDATE.md §6.2).
  5. Cache + write an `.installed` marker so later runs exec with zero network + zero re-hash.

Any hash mismatch, or an unset CHECKSUMS_SHA256 pin, is a HARD failure — the launcher never
execs an unverified binary.

======================================================================================
RELEASING — how the pin is updated per release (the ONLY manual step; keeps CI ↔ launcher in sync)
--------------------------------------------------------------------------------------
  1. Push a `v*` tag. `.github/workflows/release.yml` builds every platform binary, packages the
     model, writes `checksums.txt`, and prints `CHECKSUMS_SHA256 = "<hash>"` to the job summary.
  2. Set PINNED_VERSION to that tag and paste the printed hash into CHECKSUMS_SHA256 below, then
     commit. Users who install the plugin at that commit get a launcher pinned to verified hashes.
The two-step is inherent to any pin (the hashes only exist once the tag has built). The env
overrides below let a release engineer test the freshly-built assets before committing the pin.

======================================================================================
ENV OVERRIDES (all optional)
  GENESIS_MEMORY_BIN               use this local binary directly (dev override; skips binary DL)
  GENESIS_MODEL_DIR                use this model dir as-is if it has onnx/model.onnx + tokenizer.json
  GENESIS_CACHE_DIR                override the cache root (default: platform user-cache/genesis)
  GENESIS_MEMORY_VERSION           override PINNED_VERSION (release tag)
  GENESIS_MEMORY_CHECKSUMS_SHA256  supply/override the checksums.txt anchor (release-testing / tests)
  GENESIS_MEMORY_BASE_URL          override the release download base URL (mirrors / tests)
  GENESIS_MEMORY_MODEL_ONNX_SHA256 override the expected model.onnx hash (tests / alt revision)
======================================================================================
"""
import contextlib
import hashlib
import os
import platform
import shutil
import stat
import sys
import tarfile
import tempfile
import urllib.request

# ── Pinned identity ──────────────────────────────────────────────────────────────────
GITHUB_REPO = "Atiqul-Islam/genesis"
BINARY_STEM = "genesis-memory-server"          # Cargo [[bin]] name
MODEL_ASSET = "genesis-memory-model.tar.gz"    # model archive release asset (root: onnx/ + tokenizer.json)
CHECKSUMS_ASSET = "checksums.txt"

# The intended first release tag. Override at runtime with GENESIS_MEMORY_VERSION.
PINNED_VERSION = "v0.1.0"
# SHA-256 of `checksums.txt` for PINNED_VERSION. Filled at release time (see RELEASING above).
# Empty string = not yet pinned → the launcher fails closed rather than trusting an unverified feed.
CHECKSUMS_SHA256 = ""
# SHA-256 of onnx/model.onnx at the pinned HF revision c9745ed1…16199bf (load-bearing; == server
# embed::MODEL_SHA256 and scripts/fetch-model). Independent tie to the golden-vector revision.
MODEL_ONNX_SHA256 = "6fd5d72fe4589f189f8ebc006442dbb529bb7ce38f8082112682524616046452"

_USER_AGENT = "genesis-memory-launcher"
_HTTP_TIMEOUT = 120  # seconds; large model archive streams in chunks under this per-read timeout
_CHUNK = 256 * 1024

# Platforms with a published binary. Keys are (os_key, arch_key).
SUPPORTED = {
    ("macos", "x64"),
    ("macos", "arm64"),
    ("linux", "x64"),
    ("windows", "x64"),
}


class LauncherError(RuntimeError):
    """Any fail-closed condition (unsupported platform, checksum mismatch, missing pin)."""


def log(msg):
    """Progress/diagnostics go to STDERR only — STDOUT is the MCP channel and must stay pristine."""
    sys.stderr.write(f"[genesis-memory] {msg}\n")
    sys.stderr.flush()


# ── Platform detection ───────────────────────────────────────────────────────────────
def detect_platform():
    """Return (os_key, arch_key) for the running machine, or raise for an unsupported combo."""
    sysname = platform.system()
    os_key = {"Darwin": "macos", "Linux": "linux", "Windows": "windows"}.get(sysname)
    if os_key is None:
        raise LauncherError(f"unsupported OS {sysname!r}; supported: macOS, Linux, Windows")

    machine = platform.machine().lower()
    if machine in ("x86_64", "amd64", "x64"):
        arch_key = "x64"
    elif machine in ("arm64", "aarch64"):
        arch_key = "arm64"
    else:
        raise LauncherError(f"unsupported CPU architecture {platform.machine()!r}")

    if (os_key, arch_key) not in SUPPORTED:
        have = ", ".join(f"{o}-{a}" for o, a in sorted(SUPPORTED))
        raise LauncherError(
            f"no prebuilt genesis-memory-server for {os_key}-{arch_key}; published: {have}. "
            f"Build locally (cd server && cargo build --release) and set GENESIS_MEMORY_BIN."
        )
    return os_key, arch_key


def binary_asset_name(os_key, arch_key):
    """Release-asset filename for the platform binary (Windows carries .exe)."""
    ext = ".exe" if os_key == "windows" else ""
    return f"{BINARY_STEM}-{os_key}-{arch_key}{ext}"


def binary_filename(os_key):
    """On-disk name of the cached binary."""
    return f"{BINARY_STEM}.exe" if os_key == "windows" else BINARY_STEM


# ── Cache dir (platformdirs-style, stdlib only) ──────────────────────────────────────
def cache_root():
    """Persistent per-user cache root for Genesis downloads (created if missing).

    Honors GENESIS_CACHE_DIR, else the OS-native user cache location, so the plugin dir
    (read-only + replaced on every version bump) is never written to.
    """
    override = os.environ.get("GENESIS_CACHE_DIR")
    if override:
        root = override
    elif os.name == "nt":
        base = os.environ.get("LOCALAPPDATA") or os.path.join(
            os.path.expanduser("~"), "AppData", "Local"
        )
        root = os.path.join(base, "genesis")
    elif sys.platform == "darwin":
        root = os.path.join(os.path.expanduser("~"), "Library", "Caches", "genesis")
    else:
        base = os.environ.get("XDG_CACHE_HOME") or os.path.join(
            os.path.expanduser("~"), ".cache"
        )
        root = os.path.join(base, "genesis")
    os.makedirs(root, exist_ok=True)
    return root


# ── Hashing / verification ───────────────────────────────────────────────────────────
def sha256_file(path):
    """Streaming SHA-256 of a file (never loads the whole file into memory)."""
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(_CHUNK), b""):
            h.update(chunk)
    return h.hexdigest()


def verify(path, expected_hex, label):
    """Fail-closed check: raise LauncherError on any mismatch; return the digest on success."""
    if not expected_hex:
        raise LauncherError(f"no pinned checksum for {label}; refusing to trust it")
    actual = sha256_file(path)
    if actual.lower() != expected_hex.lower():
        with contextlib.suppress(OSError):
            os.remove(path)  # never leave an unverified artifact on disk
        raise LauncherError(
            f"checksum mismatch for {label}: expected {expected_hex.lower()}, got {actual.lower()}"
        )
    return actual


# ── Downloading (urllib; stdlib only; monkeypatch _urlopen in tests) ─────────────────
def _urlopen(url):
    req = urllib.request.Request(url, headers={"User-Agent": _USER_AGENT})
    return urllib.request.urlopen(req, timeout=_HTTP_TIMEOUT)  # HTTPS certs verified by default


def http_get_text(url):
    with contextlib.closing(_urlopen(url)) as resp:
        return resp.read().decode("utf-8")


def download_to(url, dest):
    """Stream a URL to `dest` atomically (write to .part, then os.replace)."""
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    tmp = dest + ".part"
    with contextlib.closing(_urlopen(url)) as resp, open(tmp, "wb") as f:
        shutil.copyfileobj(resp, f, length=_CHUNK)
    os.replace(tmp, dest)


# ── checksums.txt ────────────────────────────────────────────────────────────────────
def parse_checksums(text):
    """Parse `sha256sum`-style lines (`<64hex>  <filename>`) → { basename: hexdigest_lower }."""
    out = {}
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        parts = line.split(None, 1)
        if len(parts) != 2:
            continue
        digest, name = parts
        out[os.path.basename(name.strip().lstrip("*").strip())] = digest.strip().lower()
    return out


def release_base_url(version):
    override = os.environ.get("GENESIS_MEMORY_BASE_URL")
    if override:
        return override.rstrip("/")
    return f"https://github.com/{GITHUB_REPO}/releases/download/{version}"


def fetch_checksums(version, anchor, vdir):
    """Download + anchor-verify checksums.txt (cached at vdir/checksums.txt). Returns the parsed map."""
    dest = os.path.join(vdir, CHECKSUMS_ASSET)
    if os.path.exists(dest) and sha256_file(dest).lower() == anchor.lower():
        with open(dest, encoding="utf-8") as f:
            return parse_checksums(f.read())
    url = f"{release_base_url(version)}/{CHECKSUMS_ASSET}"
    log(f"fetching {CHECKSUMS_ASSET} ({version}) …")
    download_to(url, dest)
    verify(dest, anchor, CHECKSUMS_ASSET)
    with open(dest, encoding="utf-8") as f:
        return parse_checksums(f.read())


# ── Ensure binary / model in the cache ───────────────────────────────────────────────
def ensure_binary(version, checksums, os_key, arch_key, vdir):
    """Return the path to the verified cached binary, downloading it only if needed."""
    asset = binary_asset_name(os_key, arch_key)
    expected = checksums.get(asset)
    if expected is None:
        raise LauncherError(f"{CHECKSUMS_ASSET} has no entry for {asset}")
    dest = os.path.join(vdir, binary_filename(os_key))
    if os.path.exists(dest) and sha256_file(dest).lower() == expected.lower():
        return dest
    url = f"{release_base_url(version)}/{asset}"
    log(f"downloading {asset} …")
    download_to(url, dest)
    verify(dest, expected, asset)
    _make_executable(dest)
    return dest


def _expected_model_onnx_sha():
    return os.environ.get("GENESIS_MEMORY_MODEL_ONNX_SHA256") or MODEL_ONNX_SHA256


def has_model_files(model_dir):
    return os.path.isfile(os.path.join(model_dir, "onnx", "model.onnx")) and os.path.isfile(
        os.path.join(model_dir, "tokenizer.json")
    )


def _safe_extract(tar, dest):
    """Extract a tar safely (block path traversal). Uses the 3.12 data filter when available."""
    try:
        tar.extractall(dest, filter="data")  # Python 3.12+: rejects traversal/absolute paths
        return
    except TypeError:
        pass  # older Python without the filter kwarg → manual guard below
    dest_abs = os.path.abspath(dest)
    for member in tar.getmembers():
        target = os.path.abspath(os.path.join(dest, member.name))
        if target != dest_abs and not target.startswith(dest_abs + os.sep):
            raise LauncherError(f"unsafe path in model archive: {member.name!r}")
    tar.extractall(dest)


def ensure_model(version, checksums, vdir):
    """Return the path to the verified cached model dir, downloading + extracting only if needed."""
    model_dir = os.path.join(vdir, "model")
    onnx_path = os.path.join(model_dir, "onnx", "model.onnx")
    exp_onnx = _expected_model_onnx_sha()
    if has_model_files(model_dir) and sha256_file(onnx_path).lower() == exp_onnx.lower():
        return model_dir  # already present + ties to the pinned revision

    expected = checksums.get(MODEL_ASSET)
    if expected is None:
        raise LauncherError(f"{CHECKSUMS_ASSET} has no entry for {MODEL_ASSET}")
    archive = os.path.join(vdir, MODEL_ASSET)
    url = f"{release_base_url(version)}/{MODEL_ASSET}"
    log(f"downloading {MODEL_ASSET} …")
    download_to(url, archive)
    verify(archive, expected, MODEL_ASSET)

    # Fresh extraction into a clean dir.
    shutil.rmtree(model_dir, ignore_errors=True)
    os.makedirs(model_dir, exist_ok=True)
    with tarfile.open(archive, "r:gz") as tar:
        _safe_extract(tar, model_dir)
    with contextlib.suppress(OSError):
        os.remove(archive)

    if not has_model_files(model_dir):
        raise LauncherError(f"{MODEL_ASSET} did not contain onnx/model.onnx + tokenizer.json")
    verify(onnx_path, exp_onnx, "onnx/model.onnx (pinned HF revision)")
    return model_dir


# ── Install marker (fast path: skip network + re-hash on steady-state runs) ──────────
def _marker_path(vdir):
    return os.path.join(vdir, ".installed")


def marker_ok(vdir, version, anchor):
    """True iff a prior run fully verified this exact (version, anchor) into vdir."""
    try:
        with open(_marker_path(vdir), encoding="utf-8") as f:
            data = dict(
                line.split("=", 1) for line in f.read().splitlines() if "=" in line
            )
    except OSError:
        return False
    return data.get("version") == version and data.get("checksums_sha256", "").lower() == (
        anchor or ""
    ).lower()


def write_marker(vdir, version, anchor):
    tmp = _marker_path(vdir) + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(f"version={version}\nchecksums_sha256={anchor.lower()}\n")
    os.replace(tmp, _marker_path(vdir))


# ── Exec ─────────────────────────────────────────────────────────────────────────────
def _make_executable(path):
    """Best-effort: ensure the exec bit is set. Never fatal — a pre-existing executable we don't
    own (e.g. a GENESIS_MEMORY_BIN pointing at the system interpreter) may reject chmod, and that
    is fine; if the file genuinely can't be exec'd, os.execve below surfaces it."""
    if os.name != "nt":
        with contextlib.suppress(OSError):
            st = os.stat(path)
            os.chmod(path, st.st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)


def exec_transparent(bin_path, forwarded_args, env):
    """Hand off to the server so the MCP stdio stream passes through untouched.

    POSIX: os.execve — true image replacement, zero overhead, the launcher ceases to exist.
    Windows: no faithful exec-replace for a stdio child, so spawn it inheriting THIS process's
    fd 0/1/2 (the MCP bytes flow directly between client and server; the launcher touches
    neither) and propagate the child's exit code. Either way the launcher never reads/writes
    the MCP channel.
    """
    argv = [str(bin_path)] + list(forwarded_args)
    if os.name == "nt":
        import signal
        import subprocess

        proc = subprocess.Popen(argv, env=env)  # stdin/out/err inherited (transparent)
        try:
            return proc.wait()
        except KeyboardInterrupt:
            with contextlib.suppress(Exception):
                proc.send_signal(signal.CTRL_BREAK_EVENT)
            return proc.wait()
    else:
        sys.stdout.flush()
        sys.stderr.flush()
        try:
            os.execve(str(bin_path), argv, env)  # replaces this process; never returns on success
        except OSError as e:
            log(f"ERROR: cannot exec {bin_path}: {e}")
            return 1


# ── main ─────────────────────────────────────────────────────────────────────────────
def resolve(forwarded_args, environ=None):
    """Resolve (bin_path, model_dir) — downloading/verifying as needed. Pure of exec (testable)."""
    environ = os.environ if environ is None else environ
    version = environ.get("GENESIS_MEMORY_VERSION") or PINNED_VERSION
    os_key, arch_key = detect_platform()
    vdir = os.path.join(cache_root(), version)
    os.makedirs(vdir, exist_ok=True)

    dev_bin = environ.get("GENESIS_MEMORY_BIN")
    if dev_bin and not os.path.isfile(dev_bin):
        raise LauncherError(f"GENESIS_MEMORY_BIN set but not a file: {dev_bin}")

    user_model = environ.get("GENESIS_MODEL_DIR")
    user_model_ok = bool(user_model) and has_model_files(user_model)

    anchor = environ.get("GENESIS_MEMORY_CHECKSUMS_SHA256") or CHECKSUMS_SHA256

    # Fast path: a fully-verified prior install, no local overrides → exec with no network.
    managed_bin = os.path.join(vdir, binary_filename(os_key))
    managed_model = os.path.join(vdir, "model")
    if (
        not dev_bin
        and not user_model_ok
        and marker_ok(vdir, version, anchor)
        and os.path.isfile(managed_bin)
        and has_model_files(managed_model)
    ):
        return managed_bin, (user_model if user_model_ok else managed_model)

    # Something must be fetched/verified → the pin is mandatory (fail closed).
    need_download = (not dev_bin) or (not user_model_ok)
    if need_download and not anchor:
        raise LauncherError(
            "launcher is not pinned to a release yet (CHECKSUMS_SHA256 is empty). "
            "Set it from the release job summary, or use GENESIS_MEMORY_BIN + GENESIS_MODEL_DIR "
            "for local development. Refusing to run an unverified server."
        )

    checksums = fetch_checksums(version, anchor, vdir) if need_download else {}

    bin_path = dev_bin if dev_bin else ensure_binary(version, checksums, os_key, arch_key, vdir)
    if user_model_ok:
        model_dir = user_model  # trusted user/dev override — used as-is
    else:
        model_dir = ensure_model(version, checksums, vdir)

    # Only mark the managed install as trusted when BOTH managed artifacts were verified.
    if not dev_bin and not user_model_ok:
        write_marker(vdir, version, anchor)
    return bin_path, model_dir


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    try:
        bin_path, model_dir = resolve(argv)
    except LauncherError as e:
        log(f"ERROR: {e}")
        return 1
    except OSError as e:
        log(f"ERROR: {e}")
        return 1

    env = dict(os.environ)
    env["GENESIS_MODEL_DIR"] = str(model_dir)
    _make_executable(bin_path)
    log(f"exec {bin_path}")
    rc = exec_transparent(bin_path, argv, env)  # POSIX: never returns; Windows: returns child rc
    return rc if rc is not None else 0


if __name__ == "__main__":
    sys.exit(main())
