target/
test-results/
__pycache__/
*.pyc
*.onnx
# Model artifacts are fetched by scripts/fetch-model.mjs, never committed (weights + tokenizer).
server/models/
.planning/builds/
.claude/worktrees/
# Machine-local Claude Code settings (per-user permissions) — never committed.
.claude/settings.local.json
# Local runtime .db files (the memory server creates memory.db on use). The managed genesis block below
# re-includes the stores that MUST travel with the repo (memory.db + expertise.db). NOTE: a bare
# `.genesis/` here would over-ignore the whole workspace and defeat those re-includes — do not add it back.
*.db

# >>> genesis runtime (managed by bootstrap) >>>
# Commit the agent brain (expertise + hooks) AND its learned memory — both the vector DB
# (memory.db, ready-to-use with embeddings) and the portable JSONL mirror (the diff-friendly
# merge substrate) — so memory travels with the repo across systems. On `update remote`, git
# takes the latest .db and `genesis-cli reconcile` unions the JSONL so nothing is ever lost.
# Ignore only machine-local / regenerable junk (stray DBs, archived strays, temp exports).
.genesis/*
!.genesis/expertise/
!.genesis/hooks/
!.genesis/memory/
.genesis/**/__pycache__/
.genesis/expertise/.genesis/
.genesis/memory/*.tmp
.genesis/memory/archived-strays/
*.db
!.genesis/memory.db
.mcp.json
# <<< genesis runtime <<<

# Version-control the derived expertise store DB too, so genesis-engineer's brain (incl. learned rules like
# tdd-32/som-40) travels with the repo like memory.db. This sits OUTSIDE the managed block on purpose so a
# bootstrap/--sync regeneration of that block cannot re-ignore it (the source fix for bootstrapped repos is
# tracked in #23).
!.genesis/expertise/expertise.db
